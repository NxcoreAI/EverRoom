{
  "name": "@nxcore/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenNxCore local gateway service",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/bin/serve.ts",
    "build": "tsup && node scripts/copy-migrations.mjs",
    "start": "node dist/serve.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/bin/migrate.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nxcore/agent-contract": "workspace:*",
    "@nxcore/agent-runtime": "workspace:*",
    "@nxcore/agent-runtime-pi": "workspace:*",
    "@nxcore/reality-contract": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/markdown": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "ali-oss": "^6.23.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "proxy-agent": "^8.0.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
