{
  "name": "@nxcore/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenNxCore local gateway service",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/bin/serve.ts",
    "dev:cursor-completion": "tsx watch src/bin/cursor-completion-serve.ts",
    "build": "tsup && node scripts/copy-migrations.mjs",
    "start": "node dist/serve.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/memory-doc-pipeline.test.ts && vitest run tests/memory-doc-pipeline.test.ts && vitest run --dir ../../submodules/everroom-connectors/gateway-module",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/bin/migrate.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^0.1.100",
    "@nxcore/agent-contract": "workspace:*",
    "@nxcore/agent-runtime": "workspace:*",
    "@nxcore/agent-runtime-pi": "workspace:*",
    "@nxcore/connector-contract": "workspace:*",
    "@nxcore/connectors-module": "workspace:*",
    "@nxcore/document-model": "workspace:*",
    "@nxcore/reality-contract": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/markdown": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "ajv": "^8.20.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "diff": "^8.0.4",
    "drizzle-orm": "^0.45.2",
    "email-reply-parser": "^2.3.9",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "html-to-text": "^10.0.0",
    "jsonata": "^2.2.2",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.15",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "proxy-agent": "^8.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "unpdf": "^1.8.1",
    "ws": "^8.18.3",
    "yaml": "2.9.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
