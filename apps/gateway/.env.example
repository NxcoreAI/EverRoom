NXCORE_GATEWAY_HOST=127.0.0.1
NXCORE_GATEWAY_PORT=3210
NXCORE_GATEWAY_DATA_DIR=.data
NXCORE_GATEWAY_LOG_LEVEL=info
# Electron should generate and pass a fresh token for every launch.
NXCORE_GATEWAY_TOKEN=

# oo CLI routes Agent connector tools to this OpenConnector runtime.
OO_CONNECTOR_URL=http://127.0.0.1:3000
OO_CONNECTOR_TOKEN=
NXCORE_CONNECTOR_AGENT_MODE=local
NXCORE_CONNECTOR_SYNC_ENABLED=false
NXCORE_CONNECTOR_SYNC_INTERVAL_MS=300000
NXCORE_CONNECTOR_SYNC_OWNER_ID=local-user
# JSON array of domain Agent sync jobs. The Agent may only run allowedActions, maps results to the
# fixed email/document/calendar schema, and writes through guarded batch tools. Example:
# NXCORE_CONNECTOR_SYNC_JOBS=[{"id":"gmail-recent","ownerId":"local-user","service":"gmail","allowedActions":["fetch_emails","get_message"],"dataset":"emails","resourceType":"email","connectionName":"default","goal":"同步最近一天的完整邮件","prompt":"完整处理分页；正文使用纯文本。","promptVersion":1,"schemaVersion":1,"input":{"query":"newer_than:1d","detail":"full","maxResults":50}}]
NXCORE_CONNECTOR_SYNC_JOBS=
NXCORE_OO_CLI_PATH=oo

# Keep "fake" for UI development without making model requests. Use "pi" for the real runtime.
NXCORE_AGENT_RUNTIME=fake
NXCORE_AI_PROVIDER=openai
NXCORE_AI_MODEL=gpt-5.2
NXCORE_AI_BACKGROUND_MODEL=gpt-5.2
NXCORE_AI_BASE_URL=https://api.openai.com/v1
NXCORE_AI_API_KEY=
NXCORE_AI_API=openai-responses
NXCORE_AI_MAX_TOKENS=8192
NXCORE_AI_BACKGROUND_MAX_TOKENS=4096
NXCORE_AI_CONTEXT_WINDOW=128000
NXCORE_AI_TEMPERATURE=0.3
NXCORE_AI_REASONING=medium

# Long-recording ASR. Keep disabled until a user supplies their own key.
NXCORE_ASR_PROVIDER=disabled
NXCORE_ASR_ALIYUN_API_KEY=
NXCORE_ASR_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
NXCORE_ASR_ALIYUN_MODEL=qwen-audio-3.0-asr-flash-filetrans
# Recommended for FileTrans. Keep the Bucket private and use an OSS RAM user
# limited to this Bucket/prefix.
NXCORE_ASR_ALIYUN_OSS_REGION=oss-cn-beijing
NXCORE_ASR_ALIYUN_OSS_BUCKET=
NXCORE_ASR_ALIYUN_OSS_ACCESS_KEY_ID=
NXCORE_ASR_ALIYUN_OSS_ACCESS_KEY_SECRET=
NXCORE_ASR_ALIYUN_OSS_STS_TOKEN=
NXCORE_ASR_ALIYUN_OSS_PREFIX=nxcore-asr

# MemoryCore (TencentDB Agent Memory) long-term memory for the pi agent.
# Keep disabled unless a MemoryCore Gateway is running at the endpoint below.
NXCORE_MEMORY_ENABLED=false
NXCORE_MEMORY_BASE_URL=http://127.0.0.1:8420
NXCORE_MEMORY_API_KEY=
NXCORE_MEMORY_SERVICE_ID=everroom
NXCORE_MEMORY_TEAM_ID=everroom
NXCORE_MEMORY_AGENT_ID=pi-agent
NXCORE_MEMORY_USER_ID=local-user
NXCORE_MEMORY_RECALL_LIMIT=5
NXCORE_MEMORY_CHAR_BUDGET=2000
