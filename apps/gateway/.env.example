NXCORE_GATEWAY_HOST=127.0.0.1
NXCORE_GATEWAY_PORT=3210
NXCORE_GATEWAY_DATA_DIR=.data
NXCORE_GATEWAY_LOG_LEVEL=info
NXCORE_GATEWAY_HTTP_LOG_LEVEL=warn
NXCORE_NO_COLOR=0
# Electron should generate and pass a fresh token for every launch.
NXCORE_GATEWAY_TOKEN=

# Production AI credentials are delivered after SaaS login through the runtime
# configuration API. The NXCORE_AI_*/NXCORE_ASR_* values below are development-
# only compatibility inputs and are never embedded in packaged applications.

# oo CLI routes Agent connector tools to this OpenConnector runtime.
NXCORE_CLI_CONNECTOR_URL=http://127.0.0.1:3000
NXCORE_CLI_CONNECTOR_RUNTIME_TOKEN=
NXCORE_CLI_CONNECTOR_CONFIG_DIR=
NXCORE_CLI_CONNECTOR_DATA_DIR=
NXCORE_CLI_CONNECTOR_AGENT_MODE=local
NXCORE_CLI_CONNECTOR_SYNC_ENABLED=false
NXCORE_CLI_CONNECTOR_SYNC_INTERVAL_MS=300000
NXCORE_CLI_CONNECTOR_SYNC_OWNER_ID=local-user
# JSON array of domain Agent sync jobs. The Agent may only run allowedActions, maps results to the
# fixed email/document/calendar schema, and writes through guarded batch tools. Example:
# Deprecated bootstrap only: imported once when connector_sync_jobs is empty.
# Runtime task configuration is managed by the Connector UI and stored in SQLite.
# NXCORE_CLI_CONNECTOR_SYNC_JOBS=[{"id":"gmail-recent","ownerId":"local-user","service":"gmail","allowedActions":["fetch_emails","get_message"],"dataset":"emails","resourceType":"email","connectionName":"default","goal":"同步最近一天的完整邮件","schemaVersion":1,"input":{"query":"newer_than:1d","detail":"full","maxResults":50}}]
NXCORE_CLI_CONNECTOR_SYNC_JOBS=
NXCORE_CLI_CONNECTOR_CLI_PATH=oo

# Keep "fake" for UI development without making model requests. Use "pi" for the real runtime.
NXCORE_AGENT_RUNTIME=fake
# 文件驱动的 dispatch-only 子 Agent；缺省扫描仓库根目录 agents/*/agent.yaml，并随应用打包。
# NXCORE_SUBAGENTS_DIR=/absolute/path/to/everroom-agents
NXCORE_SUBAGENTS_ENABLED=true
NXCORE_SUBAGENT_TIMEOUT_MS=300000
NXCORE_SUBAGENT_MAX_CONCURRENT=4
NXCORE_AI_PROVIDER=openai
NXCORE_AI_MODEL=gpt-5.2
NXCORE_AI_BACKGROUND_MODEL=gpt-5.2
NXCORE_AI_BASE_URL=https://api.openai.com/v1
NXCORE_AI_API_KEY=
NXCORE_AI_API=openai-responses
NXCORE_AI_MAX_TOKENS=8192
NXCORE_AI_BACKGROUND_MAX_TOKENS=8192
NXCORE_AI_CONTEXT_WINDOW=128000
NXCORE_AI_TEMPERATURE=0.3
NXCORE_AI_REASONING=medium

# Long-recording ASR. Keep disabled until a user supplies their own key.
NXCORE_ASR_PROVIDER=disabled
NXCORE_ASR_ALIYUN_API_KEY=
NXCORE_ASR_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
NXCORE_ASR_ALIYUN_MODEL=qwen-audio-3.0-asr-flash-filetrans
# Optional external self-hosted Nango. Both URL and secret are required.
# The Environment API key needs connect_sessions:write and connections:list scopes.
NXCORE_NANGO_CONNECTOR_URL=
NXCORE_NANGO_CONNECTOR_SECRET=
NXCORE_NANGO_CONNECTOR_GMAIL_CONFIG_KEY=google-mail
NXCORE_NANGO_CONNECTOR_OUTLOOK_CONFIG_KEY=microsoft-mail
NXCORE_NANGO_CONNECTOR_GOOGLE_DOCS_CONFIG_KEY=google-drive
NXCORE_NANGO_CONNECTOR_NOTION_CONFIG_KEY=notion
NXCORE_NANGO_CONNECTOR_GOOGLE_CALENDAR_CONFIG_KEY=google-calendar
# 启动时自动在 Nango 创建/复用 integration 的 OAuth 凭据(留空则跳过自举)
NXCORE_NANGO_CONNECTOR_GOOGLE_CLIENT_ID=
NXCORE_NANGO_CONNECTOR_GOOGLE_CLIENT_SECRET=
NXCORE_NANGO_CONNECTOR_NOTION_CLIENT_ID=
NXCORE_NANGO_CONNECTOR_NOTION_CLIENT_SECRET=
NXCORE_NANGO_CONNECTOR_OUTLOOK_CLIENT_ID=
NXCORE_NANGO_CONNECTOR_OUTLOOK_CLIENT_SECRET=
NXCORE_NANGO_CONNECTOR_POLL_MS=300000

# Recommended for FileTrans. Keep the Bucket private and use an OSS RAM user
# limited to this Bucket/prefix.
NXCORE_ASR_ALIYUN_OSS_REGION=oss-cn-beijing
NXCORE_ASR_ALIYUN_OSS_BUCKET=
NXCORE_ASR_ALIYUN_OSS_ACCESS_KEY_ID=
NXCORE_ASR_ALIYUN_OSS_ACCESS_KEY_SECRET=
NXCORE_ASR_ALIYUN_OSS_STS_TOKEN=
NXCORE_ASR_ALIYUN_OSS_PREFIX=nxcore-asr

# MemoryCore (TencentDB Agent Memory) long-term memory for the pi agent.
# Keep disabled unless a MemoryCore Gateway is running at the endpoint below.
NXCORE_MEMORY_ENABLED=false
NXCORE_MEMORY_BASE_URL=http://127.0.0.1:8420
NXCORE_MEMORY_API_KEY=
NXCORE_MEMORY_SERVICE_ID=everroom
NXCORE_MEMORY_TEAM_ID=everroom
NXCORE_MEMORY_AGENT_ID=pi-agent
NXCORE_MEMORY_USER_ID=local-user
NXCORE_MEMORY_RECALL_LIMIT=5
NXCORE_MEMORY_CHAR_BUDGET=2000

# Knowledge Service (TencentDB Agent Memory wiki) for the pi agent's
# wiki_search / wiki_read tools (docs/room-wiki-plan.md). The desktop app
# enables ROOM_WIKIS at runtime; wikis are created lazily per Room by the
# gateway (ensureWikiForRoom), so no global WIKI_ID is injected anymore.
NXCORE_KNOWLEDGE_ENABLED=false
NXCORE_KNOWLEDGE_BASE_URL=http://127.0.0.1:8421
NXCORE_KNOWLEDGE_SERVICE_ID=everroom
NXCORE_KNOWLEDGE_TEAM_ID=everroom
# Room 级 wiki 总开关：开启后文档 commit 自动入队 ingest 到本 Room wiki，
# agent 会话按 roomId 解析挂载。全局 wiki 已取消，WIKI_ID 仅作旧配置回退。
NXCORE_KNOWLEDGE_ROOM_WIKIS_ENABLED=false
# 文档落定后的入队防抖窗口（毫秒，默认 10 分钟）。
NXCORE_KNOWLEDGE_INGEST_DEBOUNCE_MS=600000
# 自动归类路由总开关（③′实体抽取 → ③″解析 → ④链接累积 → 阈值推荐）。
# 关闭时仅 ① 入口直连（Room 内文档照常 ingest，外部信封不被接管）。
NXCORE_KNOWLEDGE_ROUTER_ENABLED=false
# 实体推荐阈值（entity-room-plan §6）：证据分 primary +1.0 / mention +0.4 /
# manual +1.5 累积；双条件同时满足进入推荐池（ready），用户确认后才建 Room。
NXCORE_KNOWLEDGE_ENTITY_PROMOTE_SCORE=2.0
NXCORE_KNOWLEDGE_ENTITY_PROMOTE_SOURCES=2
# （已废弃）自动晋升灰度开关——推荐确认制下建 Room 一律经用户确认，
# 残留的 NXCORE_KNOWLEDGE_AUTO_PROMOTE_ENABLED 会被忽略。
# NXCORE_KNOWLEDGE_AUTO_PROMOTE_ENABLED=false
# 实体合并 Dice 带：≥AUTO 且同 kind 且双方 weak → 确定性自动合并；
# [JUDGE, AUTO) → LLM 同一性判定；< JUDGE → 分立累积。
NXCORE_KNOWLEDGE_ENTITY_MERGE_AUTO_DICE=0.75
NXCORE_KNOWLEDGE_ENTITY_MERGE_JUDGE_DICE=0.6
# 抽取/判定/登记用的 LLM（OpenAI 兼容 /chat/completions）；留空回退 NXCORE_AI_*。
# 未配置 LLM 时抽取不发生：外部资料全部进未识别栏等待人工挂载。
NXCORE_KNOWLEDGE_LLM_BASE_URL=
NXCORE_KNOWLEDGE_LLM_API_KEY=
NXCORE_KNOWLEDGE_LLM_MODEL=
# 同名异实体消歧的 embedding 模型（与 LLM 同一 base_url/key）；留空 = 回退证据分高者。
NXCORE_KNOWLEDGE_EMBEDDING_MODEL=
NXCORE_KNOWLEDGE_WIKI_ID=
