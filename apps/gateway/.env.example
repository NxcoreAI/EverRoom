NXCORE_GATEWAY_HOST=127.0.0.1
NXCORE_GATEWAY_PORT=3210
NXCORE_GATEWAY_DATA_DIR=.data
NXCORE_GATEWAY_LOG_LEVEL=info
NXCORE_GATEWAY_HTTP_LOG_LEVEL=warn
NXCORE_NO_COLOR=0
# Electron should generate and pass a fresh token for every launch.
NXCORE_GATEWAY_TOKEN=

# Master key for security/credentials.enc (MCP/search API keys at rest).
# Empty = built-in hardcoded default from src/security/secret-store.ts.
NXCORE_SECRET_STORE_KEY=

# Production AI credentials are delivered after SaaS login through the runtime
# configuration API. The NXCORE_AI_* values below are development-only
# compatibility inputs and are never embedded in packaged applications.

# oo CLI routes Agent connector tools to this OpenConnector runtime.
NXCORE_CLI_CONNECTOR_URL=http://127.0.0.1:34217
NXCORE_CLI_CONNECTOR_RUNTIME_TOKEN=
NXCORE_CLI_CONNECTOR_CONFIG_DIR=
NXCORE_CLI_CONNECTOR_DATA_DIR=
NXCORE_CLI_CONNECTOR_AGENT_MODE=local
NXCORE_CLI_CONNECTOR_SYNC_ENABLED=false
NXCORE_CLI_CONNECTOR_SYNC_INTERVAL_MS=300000
NXCORE_CLI_CONNECTOR_SYNC_OWNER_ID=local-user
# JSON array of domain Agent sync jobs. The Agent may only run allowedActions, maps results to the
# fixed email/document/calendar schema, and writes through guarded batch tools. Example:
# Deprecated bootstrap only: imported once when connector_sync_jobs is empty.
# Runtime task configuration is managed by the Connector UI and stored in SQLite.
# NXCORE_CLI_CONNECTOR_SYNC_JOBS=[{"id":"gmail-recent","ownerId":"local-user","service":"gmail","allowedActions":["fetch_emails","get_message"],"dataset":"emails","resourceType":"email","connectionName":"default","goal":"同步最近一天的完整邮件","schemaVersion":1,"input":{"query":"newer_than:1d","detail":"full","maxResults":50}}]
NXCORE_CLI_CONNECTOR_SYNC_JOBS=
NXCORE_CLI_CONNECTOR_CLI_PATH=oo

# Keep "fake" for UI development without making model requests. Use "pi" for the real runtime.
NXCORE_AGENT_RUNTIME=fake
# 文件驱动的 dispatch-only 子 Agent；缺省扫描仓库根目录 agents/*/agent.yaml，并随应用打包。
# NXCORE_SUBAGENTS_DIR=/absolute/path/to/everoffice-agents
NXCORE_SUBAGENTS_ENABLED=true
NXCORE_SUBAGENT_TIMEOUT_MS=300000
NXCORE_SUBAGENT_MAX_CONCURRENT=4
NXCORE_AI_PROVIDER=openai
NXCORE_AI_MODEL=gpt-5.2
NXCORE_AI_BACKGROUND_MODEL=gpt-5.2
NXCORE_AI_BASE_URL=https://api.openai.com/v1
NXCORE_AI_API_KEY=
NXCORE_AI_API=openai-responses
NXCORE_AI_MAX_TOKENS=8192
NXCORE_AI_BACKGROUND_MAX_TOKENS=8192
NXCORE_AI_CONTEXT_WINDOW=128000
NXCORE_AI_TEMPERATURE=0.3
NXCORE_AI_REASONING=medium

# Optional external self-hosted Nango. Both URL and secret are required.
# The Environment API key needs connect_sessions:write and connections:list scopes.
NXCORE_NANGO_CONNECTOR_URL=
NXCORE_NANGO_CONNECTOR_SECRET=
NXCORE_NANGO_CONNECTOR_GMAIL_CONFIG_KEY=google-mail
NXCORE_NANGO_CONNECTOR_OUTLOOK_CONFIG_KEY=microsoft-mail
NXCORE_NANGO_CONNECTOR_GOOGLE_DOCS_CONFIG_KEY=google-drive
NXCORE_NANGO_CONNECTOR_NOTION_CONFIG_KEY=notion
NXCORE_NANGO_CONNECTOR_GOOGLE_CALENDAR_CONFIG_KEY=google-calendar
# 启动时自动在 Nango 创建/复用 integration 的 OAuth 凭据(留空则跳过自举)
NXCORE_NANGO_CONNECTOR_GOOGLE_CLIENT_ID=
NXCORE_NANGO_CONNECTOR_GOOGLE_CLIENT_SECRET=
NXCORE_NANGO_CONNECTOR_NOTION_CLIENT_ID=
NXCORE_NANGO_CONNECTOR_NOTION_CLIENT_SECRET=
NXCORE_NANGO_CONNECTOR_OUTLOOK_CLIENT_ID=
NXCORE_NANGO_CONNECTOR_OUTLOOK_CLIENT_SECRET=
NXCORE_NANGO_CONNECTOR_POLL_MS=300000
