{
  "name": "@nxcore/desktop",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/prepare-open-connector.mjs && node scripts/prepare-oo-cli.mjs && node scripts/dev.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:mac": "node scripts/prepare-open-connector.mjs && node scripts/prepare-oo-cli.mjs && pnpm run build && electron-builder --mac dmg zip --arm64"
  },
  "dependencies": {
    "@nxcore/agent-contract": "workspace:*",
    "@nxcore/connector-contract": "workspace:*",
    "@nxcore/document-model": "workspace:*",
    "@nxcore/reality-contract": "workspace:*",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@sentry/electron": "^7.16.0",
    "@tencentdb-agent-memory/knowledge-service": "https://github.com/NxcoreAI/TencentDB-Agent-Memory.git#91c967a&path:MemoryKnowledge",
    "@tencentdb-agent-memory/memory-tencentdb-v2": "https://github.com/NxcoreAI/TencentDB-Agent-Memory.git#f65f83e&path:MemoryCore",
    "@tiptap/extension-document": "^3.30.1",
    "@tiptap/extension-drag-handle-react": "^3.30.1",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-table-of-contents": "^3.30.1",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/extensions": "^3.30.1",
    "@tiptap/html": "3.30.1",
    "@tiptap/markdown": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.0",
    "docx": "^9.7.1",
    "gsap": "3.15.0",
    "i18next": "^26.3.6",
    "lucide-react": "^0.468.0",
    "pixi-viewport": "5.0.2",
    "pixi.js": "7.4.3",
    "prosemirror-changeset": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@oomol-lab/oo-cli": "1.7.5",
    "@oomol-lab/open-connector": "https://codeload.github.com/oomol-lab/open-connector/tar.gz/5719a69468c698c7cb8108e062ff64ecef8a2e65",
    "@electron/asar": "3.4.1",
    "@sentry/vite-plugin": "5.4.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.nxcore.ce",
    "productName": "EverRoom",
    "protocols": [
      {
        "name": "EverRoom sign-in callback",
        "schemes": [
          "everroom"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@esbuild/**/*"
    ],
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "!**/.env*",
      "!**/{test,tests,__tests__}/**",
      "!**/{test,spec}.*",
      "!**/*.{test,spec}.*",
      "!**/*.{map,ts,tsx,mts,cts}",
      "node_modules/@tencentdb-agent-memory/memory-tencentdb-v2/src/**/*",
      "node_modules/@tencentdb-agent-memory/knowledge-service/src/**/*"
    ],
    "extraResources": [
      {
        "from": "../gateway/dist",
        "to": "gateway",
        "filter": [
          "**/*",
          "!**/.env*",
          "!node_modules/better-sqlite3/**",
          "!**/{test,tests,__tests__}/**",
          "!**/{test,spec}.*",
          "!**/*.{test,spec}.*",
          "!**/*.{map,ts,tsx,mts,cts}"
        ]
      },
      {
        "from": "build/open-connector",
        "to": "open-connector",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/oo",
        "to": "oo",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "EverRoom needs microphone access to record and transcribe your voice.",
        "NSAudioCaptureUsageDescription": "EverRoom needs system audio access to record and transcribe audio playing on this Mac.",
        "NSDocumentsFolderUsageDescription": "EverRoom needs access to selected folders to recognize supported documents in the file app.",
        "NSDesktopFolderUsageDescription": "EverRoom needs access to selected folders to recognize supported documents in the file app."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../gateway/dist/node_modules/better-sqlite3",
          "to": "gateway/node_modules/better-sqlite3",
          "filter": [
            "lib/**/*",
            "package.json",
            "LICENSE",
            "prebuilds/darwin-arm64.node"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../gateway/dist/node_modules/better-sqlite3",
          "to": "gateway/node_modules/better-sqlite3",
          "filter": [
            "lib/**/*",
            "package.json",
            "LICENSE",
            "prebuilds/win32-x64.node"
          ]
        }
      ]
    }
  }
}
