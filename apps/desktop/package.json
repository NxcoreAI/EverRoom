{
  "name": "@nxcore/desktop",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/prepare-open-connector.mjs && node scripts/prepare-oo-cli.mjs && node scripts/prepare-lark-cli.mjs && node scripts/prepare-ntn.mjs && node scripts/prepare-acp-adapters.mjs && node scripts/prepare-genoffice-runtime.mjs && node scripts/dev.mjs",
    "build": "node scripts/prepare-genoffice-runtime.mjs && electron-vite build",
    "prepare:genoffice": "node scripts/prepare-genoffice-runtime.mjs",
    "prepare:lark-cli": "node scripts/prepare-lark-cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:mac": "node scripts/prepare-open-connector.mjs && node scripts/prepare-oo-cli.mjs && node scripts/prepare-lark-cli.mjs && node scripts/prepare-ntn.mjs && node scripts/prepare-acp-adapters.mjs && pnpm run build && electron-builder --mac dmg zip --arm64",
    "package:win": "node scripts/prepare-open-connector.mjs && node scripts/prepare-oo-cli.mjs && node scripts/prepare-lark-cli.mjs && node scripts/prepare-ntn.mjs && node scripts/prepare-acp-adapters.mjs && pnpm run build && node scripts/generate-packaged-env.mjs && electron-builder --win nsis --x64 --publish never --config.npmRebuild=false",
    "prepare:ntn": "node scripts/prepare-ntn.mjs",
    "prepare:acp-adapters": "node scripts/prepare-acp-adapters.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@nxcore/agent-contract": "workspace:*",
    "@nxcore/connector-contract": "workspace:*",
    "@nxcore/connectors-module": "workspace:*",
    "@nxcore/document-model": "workspace:*",
    "@nxcore/migration-kit": "workspace:*",
    "@nxcore/reality-contract": "workspace:*",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/electron": "^7.16.0",
    "@tiptap/extension-document": "^3.30.1",
    "@tiptap/extension-drag-handle-react": "^3.30.1",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-table-of-contents": "^3.30.1",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/extensions": "^3.30.1",
    "@tiptap/html": "3.30.1",
    "@tiptap/markdown": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "npm": "^11.19.1",
    "ntn": "0.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "remark-gfm": "^4.0.1",
    "tar-stream": "^3.2.1",
    "ws": "^8.18.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@larksuite/cli": "1.0.93",
    "@oomol-lab/oo-cli": "1.7.5",
    "@oomol-lab/open-connector": "git+https://github.com/NxcoreAI/open-connector.git#806663488c6e8df92755d473cd866a1d80f2222f",
    "@sentry/vite-plugin": "5.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "18.3.1",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.10.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.nxcore.everroom",
    "productName": "EverRoom",
    "protocols": [
      {
        "name": "EverRoom sign-in callback",
        "schemes": [
          "everroom"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@esbuild/**/*"
    ],
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "!**/.env*",
      "!**/{test,tests,__tests__}/**",
      "!**/{test,spec}.*",
      "!**/*.{test,spec}.*",
      "!**/*.{map,ts,tsx,mts,cts}",
      "!node_modules/npm/**"
    ],
    "extraResources": [
      {
        "from": "build/packaged-env.json",
        "to": "packaged-env.json"
      },
      {
        "from": "node_modules/npm",
        "to": "npm",
        "filter": [
          "**/*",
          "!**/*.md",
          "!docs/**",
          "!man/**",
          "!node_modules/.bin/**",
          "!lib/commands/test.js"
        ]
      },
      {
        "from": "../gateway/dist",
        "to": "gateway",
        "filter": [
          "**/*",
          "!**/.env*",
          "!node_modules/better-sqlite3/**",
          "!**/{test,tests,__tests__}/**",
          "!**/{test,spec}.*",
          "!**/*.{test,spec}.*",
          "!**/*.{map,ts,tsx,mts,cts}"
        ]
      },
      {
        "from": "../gateway/dist/node_modules/@napi-rs",
        "to": "gateway/node_modules/@napi-rs",
        "filter": [
          "**/*",
          "!**/*.d.ts"
        ]
      },
      {
        "from": "../gateway/dist/node_modules/pdfjs-dist",
        "to": "gateway/node_modules/pdfjs-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/open-connector",
        "to": "open-connector",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/oo",
        "to": "oo",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/lark-cli",
        "to": "lark-cli",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/ntn",
        "to": "ntn",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/genoffice-runtime",
        "to": "genoffice",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/{test,tests,__tests__}/**",
          "!**/{test,spec}.*",
          "!**/*.{map,ts,tsx,mts,cts}"
        ]
      },
      {
        "from": "build/acp-adapters",
        "to": "acp-adapters",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/package-lock.json",
          "!**/.env*",
          "!**/{test,tests,__tests__}/**",
          "!**/{test,spec}.*",
          "!**/*.{map,ts,tsx,mts,cts}",
          "!**/*.{test,spec}.*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "signIgnore": [
        "native/share/"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "EverRoom needs microphone access to record and transcribe your voice.",
        "NSAudioCaptureUsageDescription": "EverRoom needs system audio access to record and transcribe audio playing on this Mac.",
        "NSDocumentsFolderUsageDescription": "EverRoom needs access to selected folders to recognize supported documents in the file app.",
        "NSDesktopFolderUsageDescription": "EverRoom needs access to selected folders to recognize supported documents in the file app.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Word Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "docx",
              "doc"
            ],
            "LSItemContentTypes": [
              "org.openxmlformats.wordprocessingml.document",
              "com.microsoft.word.doc"
            ]
          },
          {
            "CFBundleTypeName": "Excel Workbook",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "xlsx",
              "xls"
            ],
            "LSItemContentTypes": [
              "org.openxmlformats.spreadsheetml.sheet",
              "com.microsoft.excel.xls"
            ]
          },
          {
            "CFBundleTypeName": "PowerPoint Presentation",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "pptx",
              "ppt"
            ],
            "LSItemContentTypes": [
              "org.openxmlformats.presentationml.presentation",
              "com.microsoft.powerpoint.ppt"
            ]
          }
        ]
      },
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../gateway/dist/node_modules/better-sqlite3",
          "to": "gateway/node_modules/better-sqlite3",
          "filter": [
            "lib/**/*",
            "package.json",
            "LICENSE",
            "prebuilds/darwin-arm64.node"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../gateway/dist/node_modules/better-sqlite3",
          "to": "gateway/node_modules/better-sqlite3",
          "filter": [
            "lib/**/*",
            "package.json",
            "LICENSE",
            "prebuilds/win32-x64.node"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "docx",
            "doc"
          ],
          "name": "Word Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": [
            "xlsx",
            "xls",
            "xlsm"
          ],
          "name": "Excel Workbook",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": [
            "pptx",
            "ppt"
          ],
          "name": "PowerPoint Presentation",
          "role": "Editor",
          "rank": "Alternate"
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://everroom-hu.oss-cn-beijing.aliyuncs.com/stable/"
      }
    ]
  }
}
