{
  "name": "@nxcore/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:mac": "pnpm run build && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@nxcore/agent-contract": "workspace:*",
    "@nxcore/connector-contract": "workspace:*",
    "@nxcore/reality-contract": "workspace:*",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@tiptap/extension-drag-handle-react": "^3.30.1",
    "@tiptap/extension-table-of-contents": "^3.30.1",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/extensions": "^3.30.1",
    "@tiptap/markdown": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "axios": "^1.19.0",
    "gsap": "3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.nxcore.ce",
    "productName": "EverRoom",
    "protocols": [
      {
        "name": "EverRoom sign-in callback",
        "schemes": [
          "everroom"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../gateway/dist",
        "to": "gateway",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../gateway/dist/node_modules/better-sqlite3",
        "to": "gateway/node_modules/better-sqlite3",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "EverRoom needs microphone access to record and transcribe your voice.",
        "NSAudioCaptureUsageDescription": "EverRoom needs system audio access to record and transcribe audio playing on this Mac."
      },
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
