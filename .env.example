# NxCore Gateway
NXCORE_GATEWAY_HOST=127.0.0.1
NXCORE_GATEWAY_PORT=3210
NXCORE_GATEWAY_DATA_DIR=.data
NXCORE_GATEWAY_LOG_LEVEL=info
NXCORE_GATEWAY_HTTP_LOG_LEVEL=warn
NXCORE_DESKTOP_LOG_LEVEL=info
NXCORE_DESKTOP_HTTP_LOG_LEVEL=warn
NXCORE_DESKTOP_LOG_CONSOLE=1
NXCORE_DESKTOP_LOG_FILE=1
NXCORE_SAAS_API_URL=http://127.0.0.1:4100/api/v1

# Desktop exposes exactly one of the duplicate source/connector pages.
# Default is the Data Sources page; use "connectors" to enable Connector Sync instead.
NXCORE_DESKTOP_PAGE_MODE=sources

# Connector layer defaults to the SaaS-hosted mode: after signing in to EverRoom,
# the desktop obtains the oo base URL and per-user runtime token from EverRoomSass
# (POST /app/connectors/oo/token) and talks to oo directly — no local instance.
# The overrides below apply to the local connector layer (设置 → 连接层模式) only.
# OpenConnector is bundled and managed by the desktop app by default.
NXCORE_CLI_CONNECTOR_MANAGED=true
# Optional preferred loopback port. EverRoom selects another one if it is occupied.
NXCORE_CLI_CONNECTOR_PORT=3000
# External gateway override (disabled by default):
# NXCORE_CLI_CONNECTOR_MANAGED=false
# NXCORE_CLI_CONNECTOR_URL=https://connector.example.com
# NXCORE_CLI_CONNECTOR_RUNTIME_TOKEN=
# NXCORE_CLI_CONNECTOR_ADMIN_TOKEN=  # local mode only: lets the gateway start OAuth
# NXCORE_CLI_CONNECTOR_CONFIG_DIR=
# NXCORE_CLI_CONNECTOR_DATA_DIR=
# Optional development override; packaged apps use the bundled oo CLI.
# NXCORE_CLI_CONNECTOR_CLI_PATH=oo

# Agent runtime: use "pi" after configuring the AI values below.
NXCORE_AGENT_RUNTIME=fake
# 子 Agent 目录；每个一级子目录包含 agent.yaml 和系统提示词。
# 缺省为仓库根目录 agents，并随 Gateway/Desktop 一起打包。仅开发或测试时覆盖。
# NXCORE_SUBAGENTS_DIR=/absolute/path/to/everroom-agents
NXCORE_SUBAGENTS_ENABLED=true
NXCORE_SUBAGENT_TIMEOUT_MS=300000
NXCORE_SUBAGENT_MAX_CONCURRENT=4
NXCORE_AI_PROVIDER=openai
NXCORE_AI_MODEL=gpt-5.2
NXCORE_AI_BACKGROUND_MODEL=gpt-5.2
NXCORE_AI_BASE_URL=https://api.openai.com/v1
NXCORE_AI_API_KEY=
NXCORE_AI_API=openai-responses
NXCORE_AI_MAX_TOKENS=8192
NXCORE_AI_BACKGROUND_MAX_TOKENS=8192
NXCORE_AI_CONTEXT_WINDOW=128000
NXCORE_AI_TEMPERATURE=0.3
NXCORE_AI_REASONING=medium

# 审页档（slides-reviewer，多模态）独立预算：视觉模型常用 qwen 系，输出上限
# 远小于主模型；留空沿用主模型档。SaaS 套餐下发的 vlm 槽优先生效。
# NXCORE_AI_SLIDES_REVIEWER_MODEL=qwen3-vl-flash
# NXCORE_AI_SLIDES_REVIEWER_MAX_TOKENS=16384
# NXCORE_AI_SLIDES_REVIEWER_CONTEXT_WINDOW=128000
# NXCORE_AI_SLIDES_REVIEWER_REASONING=low
