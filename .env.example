# NxCore Gateway
NXCORE_GATEWAY_HOST=127.0.0.1
NXCORE_GATEWAY_PORT=3210
NXCORE_GATEWAY_DATA_DIR=.data
NXCORE_GATEWAY_LOG_LEVEL=info
NXCORE_SAAS_API_URL=http://127.0.0.1:4100/api/v1

# OpenConnector is bundled and managed by the desktop app by default.
NXCORE_CLI_CONNECTOR_MANAGED=true
# Optional preferred loopback port. EverRoom selects another one if it is occupied.
NXCORE_CLI_CONNECTOR_PORT=3000
# External gateway override (disabled by default):
# NXCORE_CLI_CONNECTOR_MANAGED=false
# NXCORE_CLI_CONNECTOR_URL=https://connector.example.com
# NXCORE_CLI_CONNECTOR_RUNTIME_TOKEN=
# NXCORE_CLI_CONNECTOR_CONFIG_DIR=
# NXCORE_CLI_CONNECTOR_DATA_DIR=
# Optional development override; packaged apps use the bundled oo CLI.
# NXCORE_CLI_CONNECTOR_CLI_PATH=oo

# Agent runtime: use "pi" after configuring the AI values below.
NXCORE_AGENT_RUNTIME=fake
NXCORE_AI_PROVIDER=openai
NXCORE_AI_MODEL=gpt-5.2
NXCORE_AI_BACKGROUND_MODEL=gpt-5.2
NXCORE_AI_BASE_URL=https://api.openai.com/v1
NXCORE_AI_API_KEY=
NXCORE_AI_API=openai-responses
NXCORE_AI_MAX_TOKENS=8192
NXCORE_AI_BACKGROUND_MAX_TOKENS=4096
NXCORE_AI_CONTEXT_WINDOW=128000
NXCORE_AI_TEMPERATURE=0.3
NXCORE_AI_REASONING=medium

# Nango connector. The desktop app manages a local Nango instance by default.
NXCORE_NANGO_CONNECTOR_MANAGED=true
# Optional external self-hosted Nango connector.
# The Environment API key needs connect_sessions:write and connections:list scopes.
NXCORE_NANGO_CONNECTOR_URL=
NXCORE_NANGO_CONNECTOR_SECRET=
NXCORE_NANGO_CONNECTOR_GMAIL_CONFIG_KEY=google-mail
NXCORE_NANGO_CONNECTOR_OUTLOOK_CONFIG_KEY=microsoft-mail
NXCORE_NANGO_CONNECTOR_GOOGLE_DOCS_CONFIG_KEY=google-drive
NXCORE_NANGO_CONNECTOR_NOTION_CONFIG_KEY=notion
NXCORE_NANGO_CONNECTOR_GOOGLE_CALENDAR_CONFIG_KEY=google-calendar
NXCORE_NANGO_CONNECTOR_POLL_MS=300000

# Developer-only connector fault injection (requires a mock executor;
# rejected by the production Nango executor even when set).
NXCORE_NANGO_CONNECTOR_DEBUG_FAULTS=0
# MemoryCore embedding（可选,不配则向量检索关闭、BM25 兜底）。
# 经 supervisor 原样透传给 MemoryCore,优先级 env > <userData>/memory/tdai-gateway.yaml > 默认。
# 远程 provider 四项必填(PROVIDER/BASE_URL/API_KEY/MODEL + DIMENSIONS),缺任一项 embedding 自动禁用。
# TDAI_EMBEDDING_PROVIDER=openai
# TDAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# TDAI_EMBEDDING_API_KEY=
# TDAI_EMBEDDING_MODEL=text-embedding-3-small
# TDAI_EMBEDDING_DIMENSIONS=1536
# TDAI_EMBEDDING_SEND_DIMENSIONS=false   # 自部署模型(BGE-M3 等)不认 dimensions 字段时设 false
# TDAI_EMBEDDING_ENABLED=true            # 显式开关;env 下发完整远程配置时默认即启用

# MemoryCore 提炼 LLM 输出预算(不设则默认 4096)。思考型模型(GLM-5.x)推理
# 本身即可烧 3.5K+ token,4096 下密集批次会截断(fork 已有 length 防护自动
# 4 倍重试,但首调即成功更省时省钱)。建议思考型模型设 16384。
# TDAI_LLM_MAX_TOKENS=16384

# gateway 实体消歧 tie-break embedding（独立于 MemoryCore 的 TDAI_EMBEDDING_*）。
# 不配 BASE_URL/API_KEY 时沿用知识 LLM 端点（NXCORE_KNOWLEDGE_LLM_* 回退 NXCORE_AI_*）;
# embedding 模型与 LLM 不同家时（如 LLM 用 GLM、embedding 用 DashScope）必须独立配置。
# NXCORE_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
# NXCORE_KNOWLEDGE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NXCORE_KNOWLEDGE_EMBEDDING_API_KEY=
