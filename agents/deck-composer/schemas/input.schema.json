{
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "instruction"],
  "properties": {
    "task": {
      "type": "string",
      "enum": ["deck-draft", "audience-reorder"],
      "description": "The deck composition task to execute.（W4 计划扩展：density-plan）"
    },
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "本轮绑定的 Context Room；素材自取工具在此 Room 范围内检索与读取。"
    },
    "instruction": {
      "type": "string",
      "maxLength": 16000,
      "description": "User instruction：deck-draft 写演示主题/场合/篇幅期望；audience-reorder 写用户对本次重排的补充要求。最高权威。"
    },
    "material": {
      "type": "string",
      "maxLength": 100000,
      "description": "Source material excerpts assembled by the caller（Room 素材摘录），供 deck-draft 提炼。"
    },
    "blockBudget": {
      "type": "integer",
      "minimum": 4,
      "maximum": 40,
      "description": "建议产出的内容块数量；缺省 12–20（约对应 8–15 页演示）。instruction 明确要求时以 instruction 为准。"
    },
    "materialSources": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roomId", "documentId", "blockId"],
        "properties": {
          "roomId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "documentId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "blockId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "label": { "type": "string", "maxLength": 200 },
          "textPreview": { "type": "string", "maxLength": 400 }
        }
      },
      "description": "来源文档块（调用方的 document_read 结果）；草稿块的 sourceRefs 引用其 everroom://room/{roomId}/{documentId}/{blockId}。"
    },
    "memoryIndex": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roomId", "memoryId"],
        "properties": {
          "roomId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "memoryId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "label": { "type": "string", "maxLength": 200 },
          "textPreview": { "type": "string", "maxLength": 400 }
        }
      },
      "description": "Room 记忆项索引；草稿块的 sourceRefs 引用其 everroom://memory/{roomId}/{memoryId}。"
    },
    "audienceProfileId": {
      "type": "string",
      "enum": ["judge", "investor", "customer", "tech"],
      "description": "audience-reorder：受众画像 id（judge=比赛评委 investor=投资人 customer=客户 tech=技术评审）。"
    },
    "rhetoric": {
      "type": "string",
      "enum": ["pyramid", "scqa", "timeline"],
      "description": "audience-reorder：修辞结构（pyramid=金字塔原理 scqa=情境-冲突-问题-答案 timeline=时间线）。"
    },
    "draftSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "blocks"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "thesis": { "type": "string", "maxLength": 300 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "content"],
            "properties": {
              "id": { "type": "string", "pattern": "^blk_[a-z0-9]+(_[a-z0-9]+)*$" },
              "kind": { "enum": ["claim", "evidence", "data", "quote", "visual"] },
              "content": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "sourceRefs": {
                "type": "array",
                "maxItems": 10,
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "description": "audience-reorder：网关从草稿文档解析出的结构化块（顺序为草稿原序）。"
    },
    "roomTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "绑定 Room 的标题（网关注入，供上下文参考）。"
    },
    "previousDraft": {
      "type": "string",
      "maxLength": 51000,
      "description": "增量迭代的上一稿：可能是本 agent 上一稿的渲染，也可能是用户编辑后的草稿文档全文；instruction 作为其上的修改要求。"
    },
    "responseLanguage": {
      "type": "string",
      "maxLength": 32,
      "description": "输出语言（BCP-47 或语言名）；优先于素材语言。"
    }
  }
}
