{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "blocked"
      ]
    },
    "tree": {
      "type": "object",
      "description": "完整 v2 页面：version:2 + role + composition + nodes；合法字段见布局技能。提交最后校验的树。"
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "交付状态或限制；自审时记录图上关键观察、修改或保留理由、未解决问题与修改后待确认项。校验状态简述；演讲备注保存在 tree.notes。"
    },
    "designIntent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "按目标／依据／取舍说明焦点、阅读路径、关系线索与空间分配。首轮写预期效果；自审对照 previousDesignIntent 区分图片已确认、未达成与修改后待确认的效果。依据须为可指认的视觉事实，取舍如实说明限制。"
    },
    "bindings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^nodes/\\d+(?:/children/\\d+)*$"
            }
          }
        },
        "required": [
          "blockId",
          "paths"
        ],
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "requestedAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "done"
        }
      },
      "required": [
        "tree"
      ]
    },
    {
      "properties": {
        "status": {
          "const": "blocked"
        }
      },
      "required": [
        "reason",
        "attempts",
        "requestedAction"
      ],
      "not": {
        "required": [
          "tree"
        ]
      }
    }
  ]
}
