{
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "enum": [
        "layout"
      ]
    },
    "deckToken": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80,
      "description": "Deck contract token; pass verbatim to slides_layout_validate."
    },
    "pageIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "totalPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "role": {
      "type": "string",
      "enum": [
        "cover",
        "toc",
        "section",
        "content",
        "data",
        "table",
        "flow",
        "quote",
        "closing"
      ]
    },
    "density": {
      "type": "string",
      "enum": [
        "sparse",
        "standard",
        "dense"
      ]
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 500
          },
          "desc": {
            "type": "string",
            "maxLength": 200
          },
          "aspectRatio": {
            "type": "number",
            "description": "Width/height when known; keep the image leaf frame ratio close."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "styleBrief": {
      "type": "string",
      "maxLength": 400,
      "description": "Natural-language deck style tendency (e.g. strong grid, restrained whitespace)."
    },
    "layoutVersion": {
      "type": "integer",
      "enum": [
        2
      ],
      "description": "Always 2: the page you return is a v2 page (version/composition/slot nodes). There is no other layout format."
    },
    "styleTokens": {
      "type": "object",
      "additionalProperties": true,
      "description": "主题的权威快照。语义样式及文档允许的显式样式字段均服从其口径；省略组件 style 时继承 componentDefaults。"
    },
    "revisionFeedback": {
      "type": "string",
      "maxLength": 300,
      "description": "本轮修正或自审反馈；在内容契约内处理，不改变必留内容。"
    },
    "componentCandidates": {
      "type": "array",
      "maxItems": 4,
      "description": "按本页 relations/metrics/引用预检过的组件候选。存在 feasible=true 的语义匹配候选时，默认采用它承载主内容；确不适用时在 designIntent 说明候选名称、具体原因与替代表达。候选绑定真实 block，预检不截断任何内容。",
      "items": {
        "type": "object",
        "required": ["name", "relation", "blockRefs", "feasible"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "relation": { "type": "string", "description": "触发候选的关系类型；metrics 表示指标组，quote 表示引用，navigates 表示导航" },
          "blockRefs": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
          "feasible": { "type": "boolean" },
          "minSlot": {
            "type": "object",
            "required": ["w", "h"],
            "additionalProperties": false,
            "properties": { "w": { "type": "integer" }, "h": { "type": "integer" } },
            "description": "已验证槽位尺寸（px）：候选在该尺寸通过归一、展开与内容覆盖预检；不是全局最小值。"
          },
          "suggestedSlot": {
            "type": "object",
            "required": ["col", "row"],
            "additionalProperties": false,
            "properties": {
              "col": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
              "row": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
            },
            "description": "与 minSlot 对应的合法栅格槽位（12 列 × 8 行，已预留标题与页脚区）。"
          },
          "template": {
            "type": "object",
            "description": "已通过预检的组件参数（不含 type/name/slot），可直接用于组件节点承载 blockRefs 的内容。"
          },
          "note": { "type": "string", "description": "不可行时的分类原因：参数超限 / 内容无法完整映射 / 空间不足。" }
        }
      }
    },
    "currentTree": {
      "type": "object",
      "description": "视觉自审的修改基线；附件为此 v2 页面的真实渲染图。"
    },
    "previousDesignIntent": {
      "type": "string",
      "maxLength": 1000,
      "description": "首轮提交的设计目标。自审时以渲染图核对其达成情况；修改后说明目标保留、调整与待确认项。"
    },
