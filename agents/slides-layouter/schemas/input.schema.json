      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "sourceRefs",
        "role",
        "message",
        "blocks",
        "relations",
        "focusRefs",
        "constraints",
        "notes",
        "omissions"
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
