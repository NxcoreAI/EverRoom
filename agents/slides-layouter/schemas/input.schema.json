{
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "enum": [
        "layout"
      ]
    },
    "deckToken": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80,
      "description": "Deck contract token; pass verbatim to slides_layout_validate."
    },
    "pageIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "totalPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "role": {
      "type": "string",
      "enum": [
        "cover",
        "toc",
        "section",
        "content",
        "data",
        "table",
        "flow",
        "quote",
        "closing"
      ]
    },
    "density": {
      "type": "string",
      "enum": [
        "sparse",
        "standard",
        "dense"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "points": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      },
      "maxItems": 8
    },
    "data": {
      "description": "Structured page data: stats [{value,unit,label}] and optional chart {kind,categories,series}.",
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "object"
        }
      ]
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 500
          },
          "desc": {
            "type": "string",
            "maxLength": 200
          },
          "aspectRatio": {
            "type": "number",
            "description": "Width/height when known; keep the image leaf frame ratio close."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "styleBrief": {
      "type": "string",
      "maxLength": 400,
      "description": "Natural-language deck style tendency (e.g. strong grid, restrained whitespace)."
    },
    "neighborSignatures": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 4,
      "description": "仅旧内容模式重排任务使用：返回的页面须与给定邻页结构不同构。"
    },
    "layoutVersion": {
      "type": "integer",
      "enum": [
        2
      ],
      "description": "Always 2: the page you return is a v2 page (version/composition/slot nodes). There is no other layout format."
    },
    "composition": {
      "type": "string",
      "enum": [
        "immersive",
        "hero-data",
        "editorial",
        "swiss",
        "poster",
        "chapter"
      ],
      "description": "旧内容模式：上游确定的 composition，原样写入页面。语义内容模式由 Layouter 自主选择。"
    },
    "form": {
      "type": "string",
      "enum": [
        "single-fact",
        "contrast",
        "sequence",
        "hierarchy",
        "breakdown",
        "image-led",
        "quotation",
        "table",
        "light-page"
      ],
      "description": "旧内容模式：内容形态，结合 skeleton 理解本页结构。"
    },
    "units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "这页有几个单元（对照的方数、序列的步数、表格行数）。"
    },
    "skeleton": {
      "type": "string",
      "maxLength": 140,
      "description": "旧内容模式：分区与权重的骨架意图。"
    },
    "emphasis": {
      "type": "string",
      "enum": [
        "title",
        "number",
        "image",
        "quote",
        "chart",
        "table"
      ],
      "description": "v2 only: the page's single visual anchor."
    },
    "intent": {
      "type": "string",
      "maxLength": 200,
      "description": "v2 only: what this page should change in the audience's mind."
    },
    "takeaway": {
      "type": "string",
      "maxLength": 40,
      "description": "v2 only: one line the audience should remember."
    },
    "copy": {
      "type": "object",
      "description": "旧内容模式的文案来源；排版保持原文。",
      "properties": {
        "kicker": {
          "type": "string",
          "maxLength": 40
        },
        "message": {
          "type": "string",
          "maxLength": 120
        },
        "supporting": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 2
        },
        "facts": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "quote": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "attribution": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "string",
          "maxLength": 120
        },
        "speakerNotes": {
          "type": "string",
          "maxLength": 400
        }
      },
      "additionalProperties": false
    },
    "neighbors": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "pageIndex": {
            "type": "integer"
          },
          "composition": {
            "type": "string"
          },
          "takeaway": {
            "type": "string"
          },
          "form": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "prose": {
          "type": "number"
        },
        "copy": {
          "type": "number"
        },
        "notes": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "styleTokens": {
      "type": "object",
      "additionalProperties": true,
      "description": "主题的权威快照。语义样式及文档允许的显式样式字段均服从其口径；省略组件 style 时继承 componentDefaults。"
    },
    "revisionFeedback": {
      "type": "string",
      "maxLength": 300,
      "description": "本轮修正或自审反馈；按当前内容模式处理，并保留内容契约。"
    },
    "currentTree": {
      "type": "object",
      "description": "视觉自审的修改基线；附件为此 v2 页面的真实渲染图，沿用当前内容模式。"
    },
    "previousDesignIntent": {
      "type": "string",
      "maxLength": 1000,
      "description": "首轮提交的设计目标。自审时以渲染图核对其达成情况；修改后说明目标保留、调整与待确认项。"
    },
