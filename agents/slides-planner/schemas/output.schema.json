{
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "draft",
        "arrange"
      ],
      "description": "Which phase this submission is for: draft = content draft for the user to confirm; arrange = final page plan for the builder."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Deck title; also the default file name for the builder."
    },
    "narrative": {
      "type": "string",
      "maxLength": 500,
      "description": "One-sentence narrative spine and intended audience take-away; in arrange, explain the presentation emphasis within the confirmed page order."
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Display-ready page headline. Prefer an evidence-backed conclusion for argument pages; use actual names for covers, contents, and sections. Aim for 8-20 Chinese characters or equivalent reading length; preserve meaning, necessary qualifiers and user-specified wording. In arrange, use the same headline as content.message and the title block; display it once."
          },
          "role": {
            "type": "string",
            "maxLength": 20,
            "description": "arrange only. Content role hint: cover | toc | section | content | data | table | flow | quote | closing."
          },
          "density": {
            "type": "string",
            "enum": [
              "sparse",
              "standard",
              "dense"
            ],
            "description": "arrange only. Content-driven density: sparse = a few core ideas; standard = regular argument; dense = structured data. High information density comes from distinct facts and clear relationships. Keep prose concise at every density; use structured blocks for full datasets."
          },
          "points": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Display-ready short evidence or action statements, each adding distinct information beyond the headline. For regular argument pages, aim for 2-4 points of 12-28 Chinese characters each (usually no more than 40), or equivalent reading length; fewer when sufficient. Preserve subjects, conditions and uncertainty. These become mandatory on-screen sources after confirmation: put background explanation in notes and avoid repeating data. These targets are writing guidance, not truncation limits."
          },
          "data": {
            "type": "string",
            "maxLength": 2000,
            "description": "draft only. Real data as compact metric-value entries or tables, preserving values, units, dates, scope, uncertainty and source context. These become mandatory on-screen sources after confirmation. Avoid repeating the same data in points. In arrange, use structured content blocks."
          },
          "materialHints": {
            "type": "string",
            "maxLength": 300,
            "description": "draft only. One sentence on what imagery this page needs (e.g. factory floor photo, growth curve); arrange uses it to search the material library."
          },
          "materials": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(https?://|everroom-material://)",
                  "description": "Direct http(s) image link, or an everroom-material:// reference returned by the gateway material prefetch (materialHits); the engine rejects anything else."
                },
                "desc": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "What the image shows and where it fits."
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            "description": "arrange only. Material image links for this page; omit entirely when none were found."
          },
          "imagePrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "arrange only. Chinese image-generation prompt (subject/scene/composition/light/style, 120-400 chars, no real text in frame) for a page where prefetched materialHits found nothing but an image is warranted; the gateway generates the image and fills materials. Omit when materials were found or the page needs no image."
          },
          "notes": {
            "type": "string",
            "maxLength": 300,
            "description": "Background explanation, derivation, editorial gaps or directional emphasis/layout suggestions, separated from display-ready copy (no pixel-level commands). In draft, notes are optional sources for arrange; they do not replace required on-screen facts or necessary qualifiers."
          },
          "message": {
            "type": "string",
            "maxLength": 8000,
            "description": "page-level message fallback (arrange). Prefer content.message; the gateway moves it into content when content.message is missing."
          },
          "content": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "sourceRefs",
              "blocks"
            ],
            "properties": {
              "id": {
                "minLength": 1,
                "maxLength": 128,
                "type": "string"
              },
              "sourceRefs": {
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "maxLength": 128,
                  "type": "string"
                }
              },
              "role": {
                "anyOf": [
                  {
                    "const": "cover",
                    "type": "string"
                  },
                  {
                    "const": "toc",
                    "type": "string"
                  },
                  {
                    "const": "section",
                    "type": "string"
                  },
                  {
                    "const": "content",
                    "type": "string"
                  },
                  {
                    "const": "data",
                    "type": "string"
                  },
                  {
                    "const": "table",
                    "type": "string"
                  },
                  {
                    "const": "flow",
                    "type": "string"
                  },
                  {
                    "const": "quote",
                    "type": "string"
                  },
                  {
                    "const": "closing",
                    "type": "string"
                  }
                ]
              },
              "message": {
                "minLength": 1,
                "maxLength": 8000,
                "type": "string"
              },
              "blocks": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "id",
                        "sourceRefs",
                        "priority",
                        "mustShow",
                        "type",
                        "text"
                      ],
                      "properties": {
                        "id": {
                          "minLength": 1,
                          "maxLength": 128,
                          "type": "string"
                        },
                        "sourceRefs": {
                          "minItems": 1,
                          "maxItems": 128,
                          "uniqueItems": true,
                          "type": "array",
                          "items": {
                            "minLength": 1,
                            "maxLength": 128,
                            "type": "string"
                          }
                        },
                        "priority": {
                          "anyOf": [
                            {
                              "const": "primary",
                              "type": "string"
                            },
                            {
                              "const": "supporting",
                              "type": "string"
                            },
                            {
                              "const": "detail",
                              "type": "string"
                            }
                          ]
                        },
                        "mustShow": {
                          "type": "boolean"
                        },
                        "type": {
                          "const": "text",
                          "type": "string"
                        },
                        "text": {
                          "minLength": 1,
                          "maxLength": 8000,
                          "type": "string"
                        }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "id",
                        "sourceRefs",
                        "priority",
                        "mustShow",
                        "type",
                        "label",
