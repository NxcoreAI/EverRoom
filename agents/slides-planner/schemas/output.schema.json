  "required": [
    "phase",
    "title",
    "pages",
    "summary"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "arrange"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "title",
                "density",
                "content"
              ]
            }
          }
        }
      }
    }
  ]
