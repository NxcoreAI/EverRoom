{
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "draft",
        "arrange"
      ],
      "description": "Which phase to run: draft = produce the content draft for user confirmation; arrange = turn the user-confirmed draft into the final page plan."
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000,
      "description": "User goal and requirements for this slides task, within the system and schema contract. In arrange, the confirmed draft defines the content boundary."
    },
    "previousErrors": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "description": "arrange only: 上一轮网关校验给出的具体缺陷（页级/契约级）。逐条修掉，不得重复同样的来源覆盖、数字保真或 omissions 错误。"
    },
    "title": {
      "type": "string",
      "maxLength": 120,
      "description": "Deck title requested by the user; derive one when absent."
    },
    "outline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "description": "draft only: per-page titles requested by the user (order = page order; first item is the cover). Treat as the skeleton when present."
    },
    "draftPages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 8000
          },
          "points": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 8000
            }
          },
          "data": {
            "type": "string",
            "maxLength": 8000
          },
          "materialHints": {
            "type": "string",
            "maxLength": 8000
          },
          "notes": {
            "type": "string",
            "maxLength": 16000
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "referenceStyle": {
      "type": "object",
      "description": "reference-style/v1 extracted from a reference deck; palette/density/darkCover/composition/pageBudget.",
      "additionalProperties": true
    },
    "referenceOutline": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "description": "Reference deck section titles used as draft coverage guidance; related or repeated sections may be merged. In arrange, preserve the confirmed draft's pages and order."
    },
    "targetPages": {
      "type": "integer",
      "minimum": 4,
      "maximum": 32,
      "description": "Desired draft page count; overrides reference pageBudget. An explicit per-page outline takes precedence on conflict. In arrange, preserve the confirmed draft's page count."
    },
    "sourceDocuments": {
      "type": "array",
      "maxItems": 2,
      "description": "draft only: gateway-prefetched workspace document content referenced by the user. Use markdown directly as source text; do not call document read tools for these documentIds. truncated=true means only the first markdownTotalCharacters chars are included.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "title",
          "version",
          "markdown",
          "markdownTotalCharacters"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "markdown": {
            "type": "string",
            "maxLength": 40000
          },
          "markdownTotalCharacters": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          }
        }
      }
    },
    "deckStyle": {
      "type": "object",
      "additionalProperties": true,
      "description": "Minimal design brief from the confirmed style card (composition / darkCover / motif / palette). Use it for material choice and imagePrompt light-dark base; do not write hex colors into copy."
    },
    "contentMode": {
      "type": "string",
      "const": "semantic-v3"
    },
    "arrangeBatch": {
      "type": "object",
      "additionalProperties": false,
      "description": "arrange only: present when the confirmed deck is arranged in batches. draftPages/sources then cover only this batch; preserve their order and output only these pages. Do not add, drop, or reorder pages.",
      "required": [
        "index",
        "total",
        "startPageIndex",
        "pageCount",
        "deckTitle"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "startPageIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "deckTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "previousPageTitles": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "nextPageTitle": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "materialHits": {
      "type": "array",
      "maxItems": 32,
      "description": "arrange only: gateway-prefetched local material hits per page. pageIndex is 0-based in draftPages order (prewarm pageIndex is 1-based). Prefer these refs for materials.url / image assetRef; do not call material search yourself.",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pageIndex",
          "query",
          "hits"
        ],
        "properties": {
          "pageIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "hits": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "ref",
                "kind",
                "desc",
                "meta"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "kind": {
                  "type": "string",
                  "maxLength": 40
                },
                "desc": {
                  "type": "string",
                  "maxLength": 120
                },
                "meta": {
                  "type": "string",
                  "maxLength": 48
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "pageId",
          "kind",
          "value",
          "mustShow"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "pageId": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "kind": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "value": {
            "minLength": 1,
            "maxLength": 8000,
            "type": "string"
          },
          "mustShow": {
            "type": "boolean"
          }
        }
      }
    },
    "prewarmToken": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200,
      "description": "Non-batched arrange only: image-prewarm token injected by the gateway. Copy it verbatim into slides_image_prewarm for pages with an imagePrompt. Batched arrange never receives this field; the gateway handles prewarm."
    }
  },
  "required": [
    "instruction"
  ],
  "additionalProperties": false,
  "$defs": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "arrange"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "contentMode",
          "sources",
          "draftPages"
        ],
        "properties": {
          "draftPages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 8000
                },
                "points": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "maxLength": 8000
                  }
                },
                "data": {
                  "type": "string",
                  "maxLength": 8000
                },
                "materialHints": {
                  "type": "string",
                  "maxLength": 8000
                },
                "notes": {
                  "type": "string",
                  "maxLength": 16000
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
