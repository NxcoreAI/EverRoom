 const service = "feishu";
+// Request only the scopes the Feishu app has enabled as user-authorized
+// permissions (the foundational set in scopes.ts). Deriving the OAuth scope
+// list from every action's providerPermissions requests permissions the app
+// has not enabled (e.g. slash command / approval), and Feishu's authorize
+// endpoint then rejects the whole request with error 20027 before the user
+// can even see the consent page. Missing action-level permissions surface
+// as runtime errors instead, which keeps the authorization entry working.
 const feishuOAuthScopes = [
   feishuProviderScopes.offlineAccess,
-  ...new Set(feishuActions.flatMap((action) => action.providerPermissions)),
+  feishuProviderScopes.docxReadonly,
+  feishuProviderScopes.bitableAppReadonly,
 ];
 
